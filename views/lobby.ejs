<% layout('layout/boilerplate.ejs') %>

<h1>This is the lobby page </h1>

<% if(mainPlayer.isReady) { %>
		<h2 style='color: green;' id='<%=mainPlayer._id%>-ready' >Me: <%= mainPlayer.name %> </h2>
<% } else { %>
		<h2 style='color: red;' id='<%=mainPlayer._id%>-ready' >Me: <%= mainPlayer.name %> </h2>
<% } %>

<h2>Team: </h2> <ul id='team-players'> <% for(let player of teamPlayers){ %>	<% if(player.name != mainPlayer.name){ %>
		<% if(player.isReady){ %>
					<li style='color: green;' id='<%= player._id %>-ready' ><%= player.name %> - Ready: <span id='<%= player._id %>-ready-txt' ><%= player.isReady %> </span> Online: <span id='<%= player._id %>-online-txt'><%= player.isOnline %></span></li>
		<% } else { %>
					<li style='color: red;' id='<%= player._id %>-ready' ><%= player.name %> - Ready: <span id='<%= player._id %>-ready-txt' ><%= player.isReady %> </span> Online: <span id='<%= player._id %>-online-txt'><%= player.isOnline %></span></li>
		<% } %>

	<% }} %>
</ul>

<button id='profile-btn'>return to profile</button>
<button id='ready-btn'>Ready</button>

<script> 

ip = '192.168.29.233'
ip = 'localhost'
url = `http://${ip}:8000`

if(!Pusher.instances.length){
		Pusher.logToConsole = true;
		document.querySelector('#profile-btn').addEventListener('click', async e => {

				resp = await fetch(url+'/not-ready',{
						method: 'Post',
						headers: {'Content-Type': 'application/json'},
						body: JSON.stringify({ready: false}),
				})

				if(!resp.ok) throw new Error('/not-ready route failed')
				window.location.href = '/profile'
				
		})

		document.querySelector('#ready-btn').addEventListener('click', async e => {

				resp = await fetch(url+'/ready',{
						method: 'Post',
						headers: {'Content-Type': 'application/json'},
						body: JSON.stringify({ready: true})
				})
				if(!resp.ok) throw new Error('/ready route failed')

				resp = await fetch(url+'/ready-check')
				if(!resp.ok) throw new Error('/ready-check route failed')
				data = await resp.json()

				if(data.ready){
					resp = await fetch(url+'/countdown')
					if(!resp.ok) throw new Error('/countdown route failed')
				}
		})

		const pusher = new Pusher('776bdf06916235eca13c', {cluster: 'ap2'})
		const readyChannel = pusher.subscribe('ready-channel')
		readyChannel.bind('ready-event', data => {
				if(data.ready){
						document.getElementById(`${data.id}-ready`).style = 'color: green;'
						if(data.id != "<%= mainPlayer._id %>"){
								document.getElementById(`${data.id}-ready-txt`).textContent = 'true'
						}
				}else{
						document.getElementById(`${data.id}-ready`).style = 'color: red;'
						if(data.id != "<%= mainPlayer._id %>"){
								document.getElementById(`${data.id}-ready-txt`).textContent = 'false'
						}
				}
		})

		const onlineChannel = pusher.subscribe('online-channel')
		onlineChannel.bind('online-event', data => {
				if(data.online){
						if(data.id != "<%= mainPlayer._id %>"){
								console.log("login data")
								document.getElementById(`${data.id}-online-txt`).textContent = 'true'
						}}
				else{
						if(data.id != "<%= mainPlayer._id %>"){
								console.log('logout data')
								document.getElementById(`${data.id}-online-txt`).textContent = 'false'

				}
		}})

		const countdownChannel = pusher.subscribe('countdown-channel')
		countdownChannel.bind('countdown-event', data => {
				window.location.href = '/countdown'
		})
}
</script>
